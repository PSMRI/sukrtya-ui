# Sukrtya UI - Environment Configuration Example
# 
# Copy this file to .env and update values as needed for your environment.
# This file should NOT be committed to version control if it contains secrets.

# API Base URL
# The backend API endpoint that the React app will communicate with.
# Used during build time (ARG in Dockerfile) and runtime.
# 
# Examples:
#   - Local development: http://localhost:8080
#   - Staging: https://api-staging.example.com
#   - Production: https://sukrtyasiwanapi.psmri.in
REACT_APP_API_BASE_URL=https://sukrtyasiwanapi.psmri.in
